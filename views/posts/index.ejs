<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Posts - Simple Blog</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <main>
        <div class="container">
            <h1>All Blog Posts</h1>
            
            <% posts.forEach(post => { %>
                <div class="post-card">
                    <h2><%= post.title %></h2>
                    <p><small>By <%= post.author %> • <%= post.date %></small></p>
                    <p><%= post.content.substring(0, 180) %>...</p>
                    <a href="/posts/<%= post.id %>" class="read-more">Read Full Post →</a>
                </div>
            <% }); %>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>