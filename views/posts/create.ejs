<%- include('../partials/base', { title: 'Create New Post' }) %>

<div class="container">
    <h1>Create New Post</h1>
    
    <form action="/posts" method="POST">
        <input type="text" name="title" placeholder="Post Title" required>
        <textarea name="content" rows="12" placeholder="Write your content here..." required></textarea>
        <button type="submit">Publish Post</button>
    </form>
</div>